{
  "agent": "system_architect",
  "task_id": "task_0002",
  "deliverable": "architecture_design",
  "system_overview": {
    "architecture_pattern": "Microservices with Event-Driven Communication",
    "deployment_model": "Cloud-native on AWS",
    "scalability_approach": "Horizontal scaling with auto-scaling groups",
    "data_strategy": "Hybrid - Relational for user data, Vector DB for semantic search"
  },
  "components": [
    {
      "name": "API Gateway",
      "purpose": "Single entry point for all client requests",
      "technology": "AWS API Gateway + Lambda",
      "responsibilities": [
        "Request routing",
        "Authentication/authorization",
        "Rate limiting",
        "Request/response transformation"
      ],
      "scalability": "Serverless auto-scaling"
    },
    {
      "name": "Tutor Service",
      "purpose": "Core AI tutoring logic and orchestration",
      "technology": "Python FastAPI + LangChain",
      "responsibilities": [
        "Process student questions",
        "Orchestrate AI reasoning chains",
        "Generate personalized responses",
        "Manage conversation context"
      ],
      "scalability": "Containerized (ECS) with auto-scaling"
    },
    {
      "name": "LLM Integration Layer",
      "purpose": "Interface with AI/LLM providers",
      "technology": "LangChain + OpenAI/Anthropic APIs",
      "responsibilities": [
        "Prompt engineering and management",
        "LLM API calls with retry logic",
        "Response parsing and validation",
        "Cost tracking and optimization"
      ],
      "patterns": "Chain-of-thought reasoning, RAG (Retrieval Augmented Generation)"
    },
    {
      "name": "Knowledge Base Service",
      "purpose": "Store and retrieve course content and context",
      "technology": "Pinecone/Weaviate (Vector DB) + PostgreSQL",
      "responsibilities": [
        "Course material indexing",
        "Semantic search for relevant content",
        "Context retrieval for student questions",
        "Concept relationship mapping"
      ],
      "data_model": "Embeddings for semantic search, structured data for course outline"
    },
    {
      "name": "Student Profile Service",
      "purpose": "Manage student data and learning progress",
      "technology": "Node.js + PostgreSQL",
      "responsibilities": [
        "Student profile management",
        "Learning path tracking",
        "Concept mastery scoring",
        "Interaction history"
      ],
      "compliance": "FERPA-compliant data handling, encryption at rest"
    },
    {
      "name": "Analytics Service",
      "purpose": "Track usage, generate insights and reports",
      "technology": "Python + TimescaleDB + Apache Superset",
      "responsibilities": [
        "Event tracking and aggregation",
        "Student progress analytics",
        "Instructor dashboards",
        "Usage metrics and reporting"
      ],
      "features": "Real-time dashboards, scheduled reports, data export"
    },
    {
      "name": "LMS Integration Service",
      "purpose": "Integrate with Canvas and other LMS platforms",
      "technology": "Python + LTI 1.3 libraries",
      "responsibilities": [
        "LTI 1.3 authentication",
        "Grade passback",
        "Deep linking",
        "User provisioning"
      ],
      "standards": "IMS LTI 1.3, LTI Advantage"
    },
    {
      "name": "Frontend Application",
      "purpose": "Student and instructor user interfaces",
      "technology": "React + TypeScript + TailwindCSS",
      "responsibilities": [
        "Chat interface for Q&A",
        "Progress dashboards",
        "Case study interface",
        "Instructor analytics views"
      ],
      "deployment": "S3 + CloudFront CDN"
    },
    {
      "name": "Cache Layer",
      "purpose": "Improve performance and reduce costs",
      "technology": "Redis",
      "responsibilities": [
        "Frequently asked questions cache",
        "User session management",
        "Rate limiting state",
        "LLM response caching"
      ],
      "strategy": "Cache-aside pattern with TTL"
    }
  ],
  "data_flow": {
    "student_question_flow": [
      "1. Student submits question via Frontend",
      "2. API Gateway authenticates and routes to Tutor Service",
      "3. Tutor Service checks Redis cache for similar recent questions",
      "4. If cache miss, retrieve student context from Student Profile Service",
      "5. Query Knowledge Base Service for relevant course content (RAG)",
      "6. Construct prompt with context + question + relevant content",
      "7. LLM Integration Layer calls OpenAI/Claude API",
      "8. Parse and validate LLM response",
      "9. Update Student Profile with interaction",
      "10. Send event to Analytics Service",
      "11. Cache response in Redis",
      "12. Return response to Frontend"
    ],
    "analytics_flow": [
      "1. All services emit events to Analytics Service (async)",
      "2. Analytics Service aggregates events in TimescaleDB",
      "3. Scheduled jobs compute metrics (concept mastery, engagement, etc.)",
      "4. Instructor accesses dashboard via Frontend",
      "5. API Gateway routes to Analytics Service",
      "6. Analytics Service queries pre-computed metrics",
      "7. Returns formatted data to Frontend for visualization"
    ],
    "lms_integration_flow": [
      "1. Student clicks 'AI Tutor' in Canvas",
      "2. Canvas redirects to LMS Integration Service with LTI launch",
      "3. Service validates LTI signature and parameters",
      "4. Creates/updates student profile in Student Profile Service",
      "5. Generates session token",
      "6. Redirects to Frontend with session token",
      "7. Frontend loads with authenticated student context"
    ]
  },
  "api_contracts": {
    "tutor_api": {
      "base_url": "/api/v1/tutor",
      "endpoints": [
        {
          "path": "/chat",
          "method": "POST",
          "description": "Submit student question and get AI tutor response",
          "request": {
            "question": "string (required)",
            "context": "object (optional) - conversation history",
            "topic": "string (optional) - current topic/module"
          },
          "response": {
            "answer": "string - AI tutor response",
            "sources": "array - relevant course materials referenced",
            "confidence": "number - confidence score 0-1",
            "follow_up_questions": "array - suggested follow-up questions"
          }
        },
        {
          "path": "/case-study",
          "method": "POST",
          "description": "Submit case study analysis for feedback",
          "request": {
            "case_id": "string",
            "analysis": "string - student's analysis"
          },
          "response": {
            "feedback": "string - detailed feedback",
            "score": "number - 0-100",
            "strengths": "array - what student did well",
            "improvements": "array - areas for improvement"
          }
        }
      ]
    },
    "analytics_api": {
      "base_url": "/api/v1/analytics",
      "endpoints": [
        {
          "path": "/student/{student_id}/progress",
          "method": "GET",
          "description": "Get student progress across all topics",
          "response": {
            "overall_progress": "number - percentage",
            "topics": "array - per-topic mastery scores",
            "engagement_metrics": "object - time spent, questions asked, etc."
          }
        },
        {
          "path": "/course/{course_id}/insights",
          "method": "GET",
          "description": "Get instructor insights for entire course",
          "response": {
            "class_performance": "object - aggregate metrics",
            "struggling_concepts": "array - concepts with low mastery",
            "at_risk_students": "array - students needing intervention"
          }
        }
      ]
    }
  },
