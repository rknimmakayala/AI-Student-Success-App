  "adr": {
    "title": "Use RAG (Retrieval Augmented Generation) for Contextual Tutoring",
    "decision": "Implement RAG pattern with vector database for course content retrieval",
    "rationale": "RAG allows AI tutor to provide accurate, course-specific answers by grounding LLM responses in actual course materials, reducing hallucinations and ensuring educational accuracy",
    "alternatives_considered": [
      "Fine-tuning LLM on course content - rejected due to cost and maintenance",
      "Rule-based system - rejected due to lack of flexibility",
      "Pure LLM without RAG - rejected due to accuracy concerns"
    ],
    "consequences": {
      "positive": [
        "Accurate responses grounded in course materials",
        "Easy to update content without retraining",
        "Explainable (can cite sources)",
        "Lower hallucination rate"
      ],
      "negative": [
        "Additional infrastructure (vector database)",
        "More complex system architecture",
        "Slightly higher latency (retrieval step)"
      ]
    },
    "implementation_notes": "Use Pinecone for vector DB, OpenAI embeddings, LangChain for orchestration"
  },
