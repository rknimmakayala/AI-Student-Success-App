# Example secrets file for Streamlit Cloud deployment
# Copy this to secrets.toml and fill in your values

# API Base URL - Update this based on where your FastAPI backend is deployed
# For local development: http://localhost:8000
# For ngrok: https://your-ngrok-url.ngrok.io
# For Railway: https://your-app.railway.app
# For Render: https://your-app.onrender.com

API_BASE_URL = "http://localhost:8000"

# In Streamlit Cloud, add this in the app settings under "Secrets"
# Format in Streamlit Cloud secrets:
# API_BASE_URL = "https://your-deployed-backend.com"
